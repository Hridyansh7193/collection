# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Gmail SMTP Configuration for Confirmation Emails
# Note: For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SENDER_NAME="Money Collection Platform"

# Razorpay API Credentials (Get from https://dashboard.razorpay.com/#/access/api-keys)
# Leave blank to run in UPI Dynamic QR / Simulation mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase Cloud Database Configuration (PostgreSQL table viewer)
# Get from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 5 Shared UPI IDs / QRs (2 groups share 1 QR)
# QR 1: Shared by Group A & Group B
QR_PAIR_1_UPI=upi1@bank
QR_PAIR_1_NAME="CEREBREXIA 2026 (Group A & B)"

# QR 2: Shared by Group C & Group D
QR_PAIR_2_UPI=upi2@bank
QR_PAIR_2_NAME="CEREBREXIA 2026 (Group C & D)"

# QR 3: Shared by Group E & Group F
QR_PAIR_3_UPI=upi3@bank
QR_PAIR_3_NAME="CEREBREXIA 2026 (Group E & F)"

# QR 4: Shared by Group G & Group H
QR_PAIR_4_UPI=upi4@bank
QR_PAIR_4_NAME="CEREBREXIA 2026 (Group G & H)"

# QR 5: Shared by Group I & Group J
QR_PAIR_5_UPI=upi5@bank
QR_PAIR_5_NAME="CEREBREXIA 2026 (Group I & J)"

# QR 6: Shared by Group K & Group L
QR_PAIR_6_UPI=upi6@bank
QR_PAIR_6_NAME="CEREBREXIA 2026 (Group K & L)"

DEFAULT_UPI_ID=collection@upi
DEFAULT_MERCHANT_NAME="CEREBREXIA 2026"

# Group Passwords (can also be managed in config.js)
GROUP_A_PASS=alpha@groupA
GROUP_B_PASS=bravo@groupB
GROUP_C_PASS=charlie@groupC
GROUP_D_PASS=delta@groupD
GROUP_E_PASS=echo@groupE
GROUP_F_PASS=foxtrot@groupF
GROUP_G_PASS=golf@groupG
GROUP_H_PASS=hotel@groupH
GROUP_I_PASS=india@groupI
GROUP_J_PASS=juliet@groupJ
GROUP_K_PASS=kilo@groupK
GROUP_L_PASS=lima@groupL
