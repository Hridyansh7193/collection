# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Gmail SMTP Configuration for Confirmation Emails
# Note: For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SENDER_NAME="Money Collection Platform"

# Razorpay API Credentials (Get from https://dashboard.razorpay.com/#/access/api-keys)
# Leave blank to run in UPI Dynamic QR / Simulation mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# UPI Settings for Direct UPI QR Code (fallback or primary UPI ID)
DEFAULT_UPI_ID=collection@upi
DEFAULT_MERCHANT_NAME=Contribution Drive

# Group Passwords (can also be managed in config.js)
GROUP_A_PASS=alpha@groupA
GROUP_B_PASS=bravo@groupB
GROUP_C_PASS=charlie@groupC
GROUP_D_PASS=delta@groupD
GROUP_E_PASS=echo@groupE
GROUP_F_PASS=foxtrot@groupF
GROUP_G_PASS=golf@groupG
GROUP_H_PASS=hotel@groupH
GROUP_I_PASS=india@groupI
GROUP_J_PASS=juliet@groupJ
